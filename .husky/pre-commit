#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

BRANCH=$(git rev-parse --abbrev-ref HEAD)
BRANCHES="develop"

if echo "$BRANCHES" | grep -w "$BRANCH" > /dev/null; then
  echo "🚀 Detected branch '$BRANCH' — running build before commit..."
  npm run build || {
    echo "❌ Build failed. Commit aborted."
    exit 1
  }
  echo "✅ Build succeeded. Continuing commit..."
else
  echo "ℹ️ Skipping build for branch '$BRANCH'."
fi